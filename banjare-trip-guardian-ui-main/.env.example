VITE_AUTHORITY_CONSOLE_URL=http://localhost:5174
VITE_API_BASE_URL=

# Groq is called only by the serverless API. Never expose this value as VITE_*.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional: set after deploying the BanjareRecords contract.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
